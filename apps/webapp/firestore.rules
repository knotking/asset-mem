rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check ownership of the parent sharedChat document
    function isSharedChatOwner(shareId) {
      return get(/databases/$(database)/documents/sharedChats/$(shareId)).data.originalUserId == request.auth.uid;
    }

    // Public share links expire when expiresAt is set and in the past (legacy docs without expiresAt stay readable).
    function isSharedChatActive(shareId) {
      let chat = get(/databases/$(database)/documents/sharedChats/$(shareId)).data;
      return !('expiresAt' in chat) || chat.expiresAt > request.time;
    }

    function isSharedReportOwner(shareId) {
      return get(/databases/$(database)/documents/sharedReports/$(shareId)).data.originalUserId == request.auth.uid;
    }

    function isSharedReportActive(shareId) {
      let report = get(/databases/$(database)/documents/sharedReports/$(shareId)).data;
      return !('expiresAt' in report) || report.expiresAt > request.time;
    }
  
    // 1. Specific rule for billing: server-only billing (Stripe webhooks); clients may read their own summary
    // Moving this into its own explicit recursive match ensures it takes precedence.
    match /users/{userId}/billing/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Deletion audit (proxy-written; client read-only)
    match /users/{userId}/deletionAudit/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Deletion notifications (proxy creates; client may mark read/dismissed)
    match /users/{userId}/notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, delete: if false;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'dismissed']);
    }

    // 2. Catch-all rule for other user data: Users can only read/write their own data
    match /users/{userId}/{document=**} {
       allow read: if request.auth != null && request.auth.uid == userId;
       allow write: if request.auth != null && request.auth.uid == userId;
    }

    // LLM usage aggregates (written by backend only)
    match /llm_token_usage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      // Historical UTC month snapshots (archived on month rollover)
      match /periods/{periodId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Support requests (client creates messages; parent doc holds latest contact metadata)
    match /support_requests/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.status == 'open'
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 5000
          && request.resource.data.app in ['web', 'mobile'];
        allow update, delete: if false;
      }
    }

    // Mobile app version / OTA policy (read-only for clients; set via Firebase console or scripts)
    match /config/mobileApp {
      allow read: if true;
      allow write: if false;
    }

    // Rules for publicly shared property report PDFs (metadata only; PDF via proxy signed URL)
    match /sharedReports/{shareId} {
      allow read: if isSharedReportActive(shareId)
        || (request.auth != null && resource.data.originalUserId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.originalUserId == request.auth.uid;
      allow update: if request.auth != null && resource.data.originalUserId == request.auth.uid;
      allow delete: if false;
    }

    // Rules for publicly shared chat sessions
    match /sharedChats/{shareId} {
      // Owners can list/read their shares (including expired) to create or update links.
      // Public readers only see non-expired shares.
      allow read: if isSharedChatActive(shareId)
        || (request.auth != null && resource.data.originalUserId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.originalUserId == request.auth.uid;
      allow update: if request.auth != null && resource.data.originalUserId == request.auth.uid;
      allow delete: if false;

      // Messages in a shared chat are publicly readable.
      // They can only be written (created/updated/deleted in a batch) by the original owner of the share.
      match /messages/{messageId} {
        allow read: if isSharedChatActive(shareId);
        allow write: if request.auth != null && isSharedChatOwner(shareId);
      }
    }
  }
}