# Environment Configuration
# Set to "dev", "staging", or "prod"
NEXT_PUBLIC_ENV=dev

# Public site URL (canonical origin for Open Graph / metadata; no trailing slash)
# Production/staging: set in apphosting.prod.yaml / apphosting.staging.yaml — see docs/deployment/LAUNCH_PLAN_PROGRESS.md
NEXT_PUBLIC_SITE_URL=https://homegeek.ai

# Support email shown on landing contact section and legal pages
NEXT_PUBLIC_SUPPORT_EMAIL=support@homegeek.ai

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXX). Omit to disable analytics.
# Required for Product Hunt attribution — add to apphosting.prod.yaml before PH launch.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Backend API origin (no FIREBASE_WEBHOOK_SECRET path segment). Clients send Firebase ID tokens.
NEXT_PUBLIC_API_BASE_URL=https://your-proxy.run.app
# If your base URL still includes the legacy path secret, set it here to strip automatically:
# NEXT_PUBLIC_PROXY_PATH_SECRET=your-webhook-secret

# Optional UI fallback: same numeric cap as TOKEN_QUOTA_PERIOD_MAX_TOKENS on the proxy.
# The app normally reads the real default from POST /token-quota-status; this is used if that request fails.
# Omit = show Unlimited until the proxy responds (or if proxy default is unlimited).
NEXT_PUBLIC_TOKEN_QUOTA_PERIOD_MAX_TOKENS=1000000
