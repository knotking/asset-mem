# Environment Configuration
# Set to "dev", "staging", or "prod"
NEXT_PUBLIC_ENV=dev

# Public site URL (canonical origin for Open Graph / metadata; no trailing slash)
# Production/staging: set in apphosting.prod.yaml / apphosting.staging.yaml — see docs/deployment/LAUNCH_PLAN_PROGRESS.md
NEXT_PUBLIC_SITE_URL=https://asset-mem.com

# Support email shown on landing contact section and legal pages
NEXT_PUBLIC_SUPPORT_EMAIL=support@asset-mem.com

# B2B pilot program (landing #pilot section). External form URL (Tally, Typeform, Calendly).
# NEXT_PUBLIC_PILOT_FORM_URL=https://tally.so/r/your-form-id
# Optional dedicated inbox; falls back to NEXT_PUBLIC_SUPPORT_EMAIL
# NEXT_PUBLIC_PILOTS_EMAIL=pilots@asset-mem.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXX). Omit to disable analytics.
# Required for Product Hunt attribution — add to apphosting.prod.yaml before PH launch.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Backend API origin (no path secret). Clients send Firebase ID tokens.
NEXT_PUBLIC_API_BASE_URL=https://your-proxy.run.app

# Structured analysis is persisted on Firestore chat messages as contentJson + contentMarkdown.
# See gcp/agents/homecare/property_agent/ARCHITECTURE.md.
# Stripe B2C checkout: webapp sends tier "plus" / "pro"; proxy maps to Stripe Price ids via
# STRIPE_B2C_PRICE_TOKEN_CAPS_JSON (gcp/proxy/.env). See docs/billing/B2C_STRIPE_CONFIGURATION.md
#
