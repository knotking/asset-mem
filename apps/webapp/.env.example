# Environment Configuration
# Set to "dev", "staging", or "prod"
NEXT_PUBLIC_ENV=dev

# Backend API URLs
NEXT_PUBLIC_API_BASE_URL=https://your-backend-url

# Optional UI fallback: same numeric cap as TOKEN_QUOTA_PERIOD_MAX_TOKENS on the proxy.
# The app normally reads the real default from POST /token-quota-status; this is used if that request fails.
# Omit = show Unlimited until the proxy responds (or if proxy default is unlimited).
NEXT_PUBLIC_TOKEN_QUOTA_PERIOD_MAX_TOKENS=1000000
