# Environment Configuration
# Set to "dev", "staging", or "prod"
NEXT_PUBLIC_ENV=dev

# Backend API URLs
# URL for RAG file upload endpoint
NEXT_RAG_FILE_UPLOAD_URL=https://your-backend-url/rag-file-upload

# URL for agent SSE streaming endpoint
NEXT_PUBLIC_AGENT_SSE_URL=https://your-backend-url/firebase-agent-stream

# URL for agent session management endpoint
NEXT_PUBLIC_AGENT_SESSION_URL=https://your-backend-url/agent-session

# Google Gemini API Key
# Required for AI features (Genkit)
GEMINI_API_KEY=your-gemini-api-key-here
