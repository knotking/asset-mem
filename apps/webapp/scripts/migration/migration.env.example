# Firebase Migration Configuration
# Copy this file to migration.env and update with your project IDs
# Usage: source migration.env before running migration scripts

# Source Firebase project (where data is currently stored)
export SOURCE_PROJECT="goggle-gab"

# Target Firebase project (where data will be migrated to)
export TARGET_PROJECT="homegeek-staging"

# Firebase SCRYPT key for password migration (get from Firebase Console)
# See get-scrypt-params.md for instructions

export FIREBASE_SCRYPT_KEY="your_base64_signer_key_here"

export NEW_RAG_CORPUS="projects/<projectid>/locations/us-central1/ragCorpora/YOUR_CORPUS_ID"