{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "target": "es2020",
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@common/*": ["../common/src/*"],
      "@common/firebase/*": ["../common/src/firebase/*"],
      "@homeapp/common/firebase": ["../common/src/firebase/firebase-native.ts"],
      "@homeapp/common/firebase-config": ["../common/src/firebase/firebase-config.ts"],
      "@homeapp/common/types": ["../common/src/types.ts"],
      "@homeapp/common/contexts/*": ["../common/src/contexts/*"],
      "@homeapp/common/constants/*": ["../common/src/constants/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  "exclude": ["node_modules"],
  "references": [{ "path": "../common" }]
}
