# Environment variables for local development
# Copy this file to .env and fill in your values

# App Slug (optional, defaults to 'homegeekai-staging')
APP_SLUG=homegeekai

# Proxy Configuration
# The base URL and token are used to build full API URLs
PROXY_BASE_URL=https://homecare-agent-proxy-staging-321433914812.us-central1.run.app
PROXY_TOKEN=your_proxy_token_here

# Web App URL
WEB_APP_URL=https://staging--goggle-gab.us-central1.hosted.app

# Note: The following URLs are automatically built from PROXY_BASE_URL + PROXY_TOKEN:
# - agentSessionUrl: ${PROXY_BASE_URL}/${PROXY_TOKEN}/agent-session
# - agentSseUrl: ${PROXY_BASE_URL}/${PROXY_TOKEN}/firebase-agent-stream
# - ragFileUploadUrl: ${PROXY_BASE_URL}/${PROXY_TOKEN}/rag-file-upload
# - documentAnalysisUrl: ${PROXY_BASE_URL}/${PROXY_TOKEN}/extract-doc-info
