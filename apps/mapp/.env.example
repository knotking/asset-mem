# Environment variables for local development
# Copy this file to .env and fill in your values

# App Configuration
APP_ENV=dev
APP_VERSION=0.0.1
APP_SLUG=homegeekai-staging

# Bundle Identifiers (environment-specific)
IOS_BUNDLE_ID=com.homegeekai.staging
ANDROID_PACKAGE=com.homegeekai.staging

# Expo Project ID
EXPO_PROJECT_ID=cc06df81-5ad0-4fc3-ad59-6294c95e4614

# Proxy Configuration
# The base URL and token are used to build full API URLs
PROXY_BASE_URL=https://homecare-agent-proxy-staging-321433914812.us-central1.run.app
PROXY_TOKEN=your_proxy_token_here

# Web App URL
WEB_APP_URL=https://staging--homegeekdemo.us-central1.hosted.app

# Optional: same numeric cap as proxy TOKEN_QUOTA_PERIOD_MAX_TOKENS (UI fallback if token-quota-status fails)
TOKEN_QUOTA_PERIOD_MAX_TOKENS=1000000

# Note: The following URLs are automatically built from PROXY_BASE_URL + PROXY_TOKEN:
# - agentSessionUrl: ${PROXY_BASE_URL}/${PROXY_TOKEN}/agent-session
# - agentSseUrl: ${PROXY_BASE_URL}/${PROXY_TOKEN}/firebase-agent-stream
# - ragFileUploadUrl: ${PROXY_BASE_URL}/${PROXY_TOKEN}/rag-file-upload
# - documentAnalysisUrl: ${PROXY_BASE_URL}/${PROXY_TOKEN}/extract-doc-info
# - checkpointAnalysisUrl: ${PROXY_BASE_URL}/${PROXY_TOKEN}/analyze-checkpoint
# - checkpointComparisonUrl: ${PROXY_BASE_URL}/${PROXY_TOKEN}/compare-checkpoints
# - tokenQuotaStatusUrl: ${PROXY_BASE_URL}/${PROXY_TOKEN}/token-quota-status
