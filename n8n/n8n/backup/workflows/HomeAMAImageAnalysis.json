    {
      "parameters": {
        "jsCode": "function formatInspectionReport(jsonData) {\n    const output = jsonData\n    \n    let report = \"Inspection Report:\\n\\n\";\n    \n    // Problem Areas\n    report += \"Problem Areas Identified:\\n\";\n    output[\"Problem Areas Identified\"].forEach((area, index) => {\n        report += `${index + 1}. ${area.description} (Location: ${area.location})\\n`;\n          // Issue Classification\n        report += `\\nIssue Classification: ${area[\"issue_classification\"]}\\n`;\n    });\n    \n\n    report += `\\nSeverity: ${output[\"Severity Rating\"]}\\n`;\n    \n    // Estimated Measurements\n    report += \"\\nEstimated Measurements:\\n\";\n    Object.entries(output[\"Estimated Measurements\"]).forEach(([key, value]) => {\n        report += `  - ${key}: ${value}\\n`;\n    });\n    \n    // Repair Cost Estimate\n    report += \"\\nRepair Cost Estimate:\\n\";\n    report += `  - Low-end: ${output[\"Repair Cost Estimate\"][\"low_end\"]}\\n`;\n    report += `  - High-end: ${output[\"Repair Cost Estimate\"][\"high_end\"]}\\n\\n\\n`;\n    \n    return report;\n}\n// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const [index,item] of $input.all().entries()) {\n  item.json.report = formatInspectionReport($('Basic LLM Chain').all()[index].json.output)  \n}\n\nreturn $input.all();"
      },
