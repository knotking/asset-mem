# AssetMem proxy — environment template
#
# Copy to a private file (never commit secrets):
#   cp .env.example .env
#
# Local API (from gcp/proxy/api):
#   uvicorn main:app --host=0.0.0.0 --port=8080 --env-file=../.env --reload
#
# Stripe B2C setup: docs/billing/B2C_STRIPE_CONFIGURATION.md
# Token quota schema: gcp/common/token/README.md

# --- GCP core ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
# Runtime SA for GCS signed URLs via IAM signBlob (local user ADC)
GCP_SERVICE_ACCOUNT_EMAIL=githubworkflowdeployment@your-gcp-project-id.iam.gserviceaccount.com
# Optional; some Gemini paths use this (default us-central1 in checkpoint service)
# GCP_LOCATION=us-central1
# FIREBASE_PROJECT_ID=your-gcp-project-id

# Vertex AI Reasoning Engine (agent stream / sessions)
REASONING_ENGINE_ID=your-reasoning-engine-id

# --- Storage & Pub/Sub (async workers) ---
GCS_BUCKET=your-user-data-bucket
# Firebase client Storage (documents/, uploads/) — defaults to {GCP_PROJECT_ID}.firebasestorage.app
FIREBASE_STORAGE_BUCKET=homegeek-staging.firebasestorage.app
USER_UPLOAD_TOPIC=user-upload-topic
USER_UPLOAD_RESULT_SUBSCRIPTION=user-upload-result-subscription
CHECKPOINT_ANALYSIS_TOPIC=checkpoint-analysis-topic
CHECKPOINT_METRICS_TOPIC=checkpoint-metrics-topic
DOCUMENT_ANALYSIS_TOPIC=document-analysis-topic
REPORT_GENERATION_TOPIC=report-generation-topic-staging
# Optional: publish after checkpoint metrics aggregation
# CHECKPOINT_METRICS_RESULT_TOPIC=checkpoint-metrics-result-topic

# --- Auth / routing ---
# Shared path prefix for legacy routes (ENABLE_LEGACY_SECRET_PREFIX only)
FIREBASE_WEBHOOK_SECRET=your-firebase-webhook-secret
# Often the same value as FIREBASE_WEBHOOK_SECRET
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Local only: skip Firebase Bearer verification (pytest / trusted local clients)
# DISABLE_FIREBASE_AUTH=true
# Mount routes under /{FIREBASE_WEBHOOK_SECRET}/ as well as /
# ENABLE_LEGACY_SECRET_PREFIX=true

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-from-botfather

# --- Stripe B2C billing (plan limits: free tier + Stripe Price ids) ---
# sk_test_… or sk_live_… — proxy only, never in webapp
STRIPE_SECRET_KEY=sk_test_...
# Dashboard webhook signing secret, or `stripe listen` output for local dev
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
# Public webapp origin (no trailing slash) for Checkout / Portal return URLs
BILLING_PUBLIC_APP_BASE_URL=http://localhost:9002
# Required for quota enforcement. Reserved key "free" = non-subscribers; other keys = Stripe Price ids.
# Local dev: plain JSON. Cloud Run deploy workflows base64-encode (see gcp/proxy/scripts/prepare-stripe-b2c-caps-github-env.sh).
STRIPE_B2C_PRICE_TOKEN_CAPS_JSON={"free":{"monthlyTokenLimit":1000000,"monthlyDocumentLimit":2,"monthlyCheckpointLimit":5,"monthlyReportGenerationsLimit":2},"plus":{"stripePriceId":"price_plus_xxx","monthlyTokenLimit":10000000,"monthlyDocumentLimit":10,"monthlyCheckpointLimit":30,"monthlyReportGenerationsLimit":10},"pro":{"stripePriceId":"price_pro_yyy","monthlyTokenLimit":25000000,"monthlyDocumentLimit":30,"monthlyCheckpointLimit":100,"monthlyReportGenerationsLimit":30}}

# --- RAG user-docs worker (same .env when running workers locally; not required for API-only) ---
# RAG_CORPUS=projects/your-project/locations/us-central1/ragCorpora/your-corpus-id
# USER_UPLOAD_RESULT_TOPIC=projects/your-project/topics/user-upload-result-topic

# --- Optional proxy tuning ---
# Property-address search geo: Google Geocoding (street-level) when set; otherwise
# the proxy falls back to SerpAPI locations.json (city-level, no extra key).
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Comma-separated browser origins; empty = built-in allowlist
# PROXY_CORS_ORIGINS=http://localhost:9002
# PROXY_RATE_LIMIT_ENABLED=true
# PROXY_OBSERVABILITY_TRACING=false
# PROXY_OBSERVABILITY_METRICS=false

# --- Scripts (test_token_usage_request.py) ---
# TEST_USER_ID=your-firebase-auth-uid
# TEST_FIREBASE_ID_TOKEN=
# PROXY_BASE_URL=http://127.0.0.1:8080
# Assistant chat persistence is prose-only by default (no ```json in message content)
