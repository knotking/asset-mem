        ],
        "summary": "Service Broker Webhook",
        "description": "Handle incoming webhooks for the service broker agent.",
        "operationId": "service_broker_agent_webhook_mock_secret_service_broker_agent_post",
        "responses": {
          "200": {
            "description": "Successful Response",
