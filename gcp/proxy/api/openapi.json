  "components": {
    "schemas": {
      "AgentRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "Unique identifier for the user"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Session ID for the conversation context",
            "default": ""
          },
          "user_query": {
            "type": "string",
            "title": "User Query",
            "description": "The query or prompt from the user",
            "default": "Analyse"
          },
          "context_doc_uris": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Context Doc Uris",
            "description": "List of GCS URIs for context documents"
          },
          "checkpoint_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkpoint Ids",
            "description": "Checkpoint IDs for checkpoint context (enables checkpoint_agent routing)"
          },
          "property_address": {
            "type": "string",
            "title": "Property Address",
            "description": "Property record address (identity/context only, not market geo)",
            "default": ""
          },
          "search_location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SearchLocationRequest"
              },
              {
                "type": "null"
              }
            ],
            "description": "Unified search/market location (resolved server-side for agents)"
          },
          "property_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Property Id",
            "description": "Property ID for property-specific queries (e.g., checkpoint retrieval)"
          },
          "primary_agent": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "checkpoint",
                  "docs"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Agent",
            "description": "Primary agent selection for explicit routing: 'checkpoint' for checkpoint queries, 'docs' for document queries"
          },
          "checkpoint_optional_agents": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checkpoint Optional Agents",
            "description": "List of optional agents to include in checkpoint analysis"
          },
          "location_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "address",
                  "location"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Type",
            "description": "Deprecated. Use search_location.source instead."
          },
          "location_coordinates": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Coordinates",
            "description": "Deprecated. Use search_location.coordinates instead."
          },
          "location_radius": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Radius",
            "description": "Deprecated. Use search_location.radius_miles instead."
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "AgentRequest"
      },
      "AnalyzeCheckpointRequest": {
        "properties": {
          "imageUrl": {
            "type": "string",
            "title": "Imageurl"
          },
          "contentType": {
            "type": "string",
            "title": "Contenttype"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "checkpointId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkpointid"
          },
          "userId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Userid"
          },
          "propertyId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Propertyid"
          }
        },
        "type": "object",
        "required": [
          "imageUrl",
          "contentType"
        ],
        "title": "AnalyzeCheckpointRequest"
      },
      "CompareCheckpointsRequest": {
        "properties": {
          "image1Url": {
            "type": "string",
            "title": "Image1Url"
          },
          "image2Url": {
            "type": "string",
            "title": "Image2Url"
          },
          "contentType1": {
            "type": "string",
            "title": "Contenttype1"
          },
          "contentType2": {
            "type": "string",
            "title": "Contenttype2"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          }
        },
        "type": "object",
        "required": [
          "image1Url",
          "image2Url",
          "contentType1",
          "contentType2"
        ],
        "title": "CompareCheckpointsRequest"
      },
      "ExtractDocInfoRequest": {
        "properties": {
          "docId": {
            "type": "string",
            "title": "Docid",
            "description": "Firestore document id under users/{userId}/docs"
          },
          "docUrl": {
            "type": "string",
            "title": "Docurl",
            "description": "The GCS URL of the document to analyze (gs://...)"
          },
          "contentType": {
            "type": "string",
            "title": "Contenttype",
            "description": "MIME type of the document"
          },
          "userId": {
            "type": "string",
            "title": "Userid",
            "description": "Firebase Auth UID \u2014 required for quota accounting and Firestore path"
          }
        },
        "type": "object",
        "required": [
          "docId",
          "docUrl",
          "contentType",
          "userId"
        ],
        "title": "ExtractDocInfoRequest",
        "description": "Queue document extraction; the worker updates `users/{userId}/docs/{docId}` in Firestore."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SearchLocationCoordinatesRequest": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "title": "SearchLocationCoordinatesRequest"
      },
      "SearchLocationRequest": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "property_address",
              "device_gps"
            ],
            "title": "Source"
          },
          "radius_miles": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Radius Miles",
            "description": "Search radius in miles (5-100)"
          },
          "coordinates": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SearchLocationCoordinatesRequest"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required when source is device_gps"
          }
        },
        "type": "object",
        "required": [
          "source"
        ],
        "title": "SearchLocationRequest",
        "description": "Client search location (resolved to canonical search_location in proxy)."
      },
      "SessionRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "Unique identifier for the user"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Session ID to operate on"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "SessionRequest"
      },
      "TokenQuotaStatusRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1,
            "title": "User Id",
            "description": "Firebase Auth UID"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "TokenQuotaStatusRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}