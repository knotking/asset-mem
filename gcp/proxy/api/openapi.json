  "components": {
    "schemas": {
      "AgentRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "default": ""
          },
          "user_query": {
            "type": "string",
            "title": "User Query",
            "default": "Analyse"
          },
          "context_doc_uris": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Context Doc Uris"
          },
          "diagnosis_uris": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Diagnosis Uris"
          },
          "property_address": {
            "type": "string",
            "title": "Property Address",
            "default": ""
          },
          "analysis_optional_agents": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Analysis Optional Agents"
          },
          "location_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "address",
                  "location"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Type"
          },
          "location_coordinates": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Coordinates"
          },
          "location_radius": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location Radius"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "AgentRequest"
      },
      "AnalyzeCheckpointRequest": {
        "properties": {
          "imageUrl": {
            "type": "string",
            "title": "Imageurl"
          },
          "contentType": {
            "type": "string",
            "title": "Contenttype"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "checkpointId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkpointid"
          },
          "userId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Userid"
          },
          "propertyId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Propertyid"
          }
        },
        "type": "object",
        "required": [
          "imageUrl",
          "contentType"
        ],
        "title": "AnalyzeCheckpointRequest"
      },
      "CompareCheckpointsRequest": {
        "properties": {
          "image1Url": {
            "type": "string",
            "title": "Image1Url"
          },
          "image2Url": {
            "type": "string",
            "title": "Image2Url"
          },
          "contentType1": {
            "type": "string",
            "title": "Contenttype1"
          },
          "contentType2": {
            "type": "string",
            "title": "Contenttype2"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          }
        },
        "type": "object",
        "required": [
          "image1Url",
          "image2Url",
          "contentType1",
          "contentType2"
        ],
        "title": "CompareCheckpointsRequest"
      },
      "ExtractDocInfoRequest": {
        "properties": {
          "docId": {
            "type": "string",
            "title": "Doc Id"
          },
          "docUrl": {
            "type": "string",
            "title": "Docurl"
          },
          "contentType": {
            "type": "string",
            "title": "Contenttype"
          },
          "userId": {
            "type": "string",
            "title": "User Id"
          }
        },
        "type": "object",
        "required": [
          "docId",
          "docUrl",
          "contentType",
          "userId"
        ],
        "title": "ExtractDocInfoRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SessionRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "SessionRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
