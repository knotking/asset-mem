              }
            }
          }
        }
      }
    },
    "/mock_secret/analyze-checkpoint": {
      "post": {
        "summary": "Analyze Checkpoint Endpoint",
        "description": "Analyze a property checkpoint image using Gemini AI.\n\nThis endpoint publishes the analysis request to Pub/Sub for async processing.\nReturns immediately (202 Accepted). The worker function will process the\nanalysis and update Firestore directly. Frontend should listen to Firestore\nchanges to see when analysis completes.\n\nRequires: checkpointId, userId, propertyId for Firestore update.",
        "operationId": "analyze_checkpoint_endpoint_mock_secret_analyze_checkpoint_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeCheckpointRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/mock_secret/compare-checkpoints": {
      "post": {
        "summary": "Compare Checkpoints Endpoint",
        "description": "Compare two checkpoint images (previous vs current) using Gemini AI.\nReturns structured comparison data including similarity score, semantic changes, and specific regions of interest.",
        "operationId": "compare_checkpoints_endpoint_mock_secret_compare_checkpoints_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareCheckpointsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
