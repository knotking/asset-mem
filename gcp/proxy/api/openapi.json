    "/mock_secret/extract-doc-info": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Queue document extraction",
        "description": "Publishes document analysis to Pub/Sub. The worker updates the Firestore doc (`users/{userId}/docs/{docId}`) when complete. Clients should listen on that document.",
        "operationId": "extract_document_info_endpoint_mock_secret_extract_doc_info_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
