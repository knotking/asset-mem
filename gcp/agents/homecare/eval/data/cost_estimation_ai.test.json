  {
    "test_name": "AI estimation with location - San Francisco plumbing",
    "query": "{\"diagnosis\": \"Leaking pipe under kitchen sink, appears to be a loose connection\", \"property_address\": \"123 Market St, San Francisco, CA 94103\"}",
    "expected_behavior": {
      "should_use_ai": true,
      "should_have_location_context": true,
      "expected_cost_range_diy": "$25-150",
      "expected_cost_range_pro": "$200-600",
      "should_reflect_sf_pricing": true
    },
    "validation_rules": {
      "has_cost_estimates": true,
      "has_diy_section": true,
      "has_service_section": true,
      "has_comparison": true,
      "diy_lower_than_pro": true,
      "cost_ranges_valid_format": true
    }
  },
