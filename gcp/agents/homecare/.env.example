# Copy as .env file and fill your values below
# Run ./update_dotenv_example.sh to update .env-example from your .env file.

# Choose Model Backend: 0 -> ML Dev, 1 -> Vertex
GOOGLE_GENAI_USE_VERTEXAI=1

# ML Dev backend config
GOOGLE_API_KEY=YOUR_VALUE_HERE

# Vertex backend config
# Rag Engine only works with Vertex. So we should configure it to use Vertex:
GOOGLE_CLOUD_PROJECT=YOUR_VALUE_HERE
# Regional Vertex resources (RAG, embeddings). Root executor uses Gemini3 location=global — do not rely on this for gemini-3.1-flash-lite chat.
GOOGLE_CLOUD_LOCATION=YOUR_VALUE_HERE

# Existing corpus in Vertex RAG Engine to be used by RAG agent
# e.g. projects/123/locations/us-central1/ragCorpora/456
RAG_CORPUS=YOUR_VALUE_HERE 

# Staging bucket name for ADK agent deployment to Vertex AI Agent Engine (Shall respect this format gs://your-bucket-name)
STAGING_BUCKET=YOUR_VALUE_HERE

# Agent Engine ID in the following format: projects/<PROJECT_NUMBER>/locations/us-central1/reasoningEngines/<AGENT_ENGINE_ID>
AGENT_ENGINE_ID=YOUR_VALUE_HERE

# ADK post-invocation session compaction (Agent Engine + adk web when using property_agent app)
# ADK session event compaction (post-invocation; gemini-3.5-flash executor)
# ADK_EVENTS_COMPACTION_DISABLED=1
# ADK_COMPACTION_TOKEN_THRESHOLD=130000   # default ~65% of 200k effective context
# ADK_COMPACTION_EVENT_RETENTION_SIZE=32  # recent raw events kept after compact
# ADK_COMPACTION_INTERVAL=10000
# ADK_COMPACTION_OVERLAP_SIZE=1
# Stream checkpoint branch progress in adk web / Agent Engine (HomecareRunner). Default on.
# Set automatically on Agent Engine deploy (deployment/deploy.py); override here for local runs.
# HOMEAPP_CHECKPOINT_PROGRESS_RUNNER=1
# Emit checkpoint pipeline timing metrics (retrieval, branches, synthesis). Default on.
# CHECKPOINT_TIMING_METRICS=1

# Agent deploy script logging (deployment/deploy.py). Default INFO; use DEBUG only locally.
# AGENT_DEPLOY_LOG_LEVEL=INFO

# SerpAPI / reverse-geocode in-process cache TTL (seconds). 0 disables caching.
# SERPAPI_GEO_CACHE_TTL_SECONDS=86400

# DIY YouTube search: serpapi (default) | data_api | auto
# data_api uses YOUTUBE_API_KEY + optional lat/lng radius; serpapi uses SERP_API_KEY.
# DIY_YOUTUBE_SEARCH_BACKEND=data_api
# DIY_YOUTUBE_LOCATION_RADIUS_KM=2000

# Google Search grounding (DIY web prefetch + AI cost estimator)
# GOOGLE_SEARCH_DYNAMIC_RETRIEVAL=1
# GOOGLE_SEARCH_DYNAMIC_THRESHOLD=0.45
# CHECKPOINT_GROUNDING_PREFETCH=1
# AI_ESTIMATION_TIMEOUT=30
# DIY_WEB_GROUNDING_MAX_OUTPUT_TOKENS=1024  # Default reduced from 1536 for faster web grounding
# DIY_STEPS_LLM_MAX_OUTPUT_TOKENS=2048  # Default reduced from 3072 for faster synthesis
# DIY_STEPS_WEB_EXCERPT_CHARS=1500  # Default reduced from 2200 for tighter prompt
# DIY_STEPS_THINKING=minimal  # steps synthesis (minimal|low|medium|high); use 0 for legacy thinking_budget=0
# DIY_WEB_THINKING=low  # grounded web search (default low — balance speed vs step depth; minimal was ~8s but thinner steps)
# COST_MARKET_THINKING=low  # AI cost market web grounding (Google Search)
# COST_AI_THINKING=minimal  # AI cost structured JSON estimate
# MEDIA_SEARCH_REFINE_THINKING=minimal  # checkpoint retrieval branch-intent refiner
# CHECKPOINT_SYNTHESIS_THINKING=low  # executive-summary markdown after branch analysis
# COST_ESTIMATION_MODEL=gemini-3.5-flash  # override AI cost JSON model (default matches SINGLE_LOOP)
# DIY_ORCHESTRATOR_CACHE_TTL_SECONDS=900  # Default increased from 300 for better cache hit rate

# Removed in Phase 5 (single-loop is unconditional): RESOLVE_LLM_DISABLED,
# HOMEAPP_EXECUTOR_ONLY_ROUTING, HOMEAPP_NLU_FIRST_RESOLVE

# Observability (optional; default on)
# AGENT_ROUTING_METRICS=1
# AGENT_MESSAGE_METRICS=1 (off by default; requires Agent Engine + VertexAiMemoryBankService)
# HOMEAPP_CONVERSATION_SUMMARY=1  # rolling flash-lite summary (off by default; ADK compaction primary)
# ADK_MEMORY_INGEST_ENABLED=1
# ADK_MEMORY_PRELOAD_ENABLED=1
# ADK_MEMORY_FORCE_FLUSH=1
# ADK_MEMORY_STREAM_PREFIX=staging-
# ADK_MEMORY_IDLE_DURATION=60s
